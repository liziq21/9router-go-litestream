+// deleteLTXFilesIndividually is a compatibility fallback for S3-compatible
+// providers that implement DeleteObject but reject DeleteObjects.
+func (c *ReplicaClient) deleteLTXFilesIndividually(ctx context.Context, objIDs []types.ObjectIdentifier) error {
+	for _, objID := range objIDs {
+		key := aws.ToString(objID.Key)
+		start := time.Now()
+		_, err := c.s3.DeleteObject(ctx, &s3.DeleteObjectInput{
+			Bucket: aws.String(c.Bucket),
+			Key:    objID.Key,
+		})
+		duration := time.Since(start)
+		internal.OperationDurationHistogramVec.WithLabelValues(ReplicaClientType, "DELETE").Observe(duration.Seconds())
+
+		if err != nil {
+			internal.OperationErrorCounterVec.WithLabelValues(ReplicaClientType, "DELETE", "DeleteObject").Inc()
+			return fmt.Errorf("s3: delete object %s: %w", key, err)
+		}
+
+		internal.OperationTotalCounterVec.WithLabelValues(ReplicaClientType, "DELETE").Inc()
+		c.logger.Debug("individual ltx delete completed", "key", key, "duration_ms", duration.Milliseconds())
+	}
+	return nil
+}
