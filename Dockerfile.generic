# ==========================================
# Stage 1: Build the pinned custom Litestream binary.
# The source commit and local patches are fixed in this repository.
# ==========================================
FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS litestream_bin

WORKDIR /src
ADD https://github.com/benbjohnson/litestream/archive/ccd326c175b583b5e82893a6078f06dcef5fba3f.tar.gz /tmp/litestream.tar.gz
COPY patches/litestream-delete-fallback.patch /tmp/litestream-delete-fallback.patch
COPY patches/litestream-restore-parallel.patch /tmp/litestream-restore-parallel.patch
RUN apk add --no-cache patch \
    && tar -xzf /tmp/litestream.tar.gz --strip-components=1 -C /src \
    && patch -d /src -p1 < /tmp/litestream-delete-fallback.patch \
    && patch -d /src -p1 < /tmp/litestream-restore-parallel.patch \
    && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.Version=v0.5.17-custom" \
        -o /usr/local/bin/litestream ./cmd/litestream

# ==========================================
# Stage 2: A small, buildable generic SQLite example.
# The application command, user, data directory, and port are explicit image
# contract values. LITESTREAM_DB_PATH is intentionally not set here: users
# must provide it whenever replication is enabled.
# ==========================================
FROM python:3.15-alpine@sha256:20a82dbc2783112ddb91d1534603f802d222a3e63e593cd002eb2ac534e70211
USER root

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    APP_HOST=0.0.0.0 \
    DATA_DIR=/var/lib/generic-sqlite \
    DB_PATH=/var/lib/generic-sqlite/data.sqlite \
    APP_USER=sqlite \
    APP_GROUP=sqlite

RUN apk add --no-cache ca-certificates su-exec \
    && addgroup -S sqlite \
    && adduser -S -G sqlite sqlite \
    && mkdir -p /var/lib/generic-sqlite /opt/generic-sqlite \
    && chown -R sqlite:sqlite /var/lib/generic-sqlite /opt/generic-sqlite

COPY --from=litestream_bin /usr/local/bin/litestream /usr/local/bin/litestream
COPY litestream.yml /etc/litestream.yml
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY examples/generic-sqlite/app.py /opt/generic-sqlite/app.py
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "/opt/generic-sqlite/app.py"]
